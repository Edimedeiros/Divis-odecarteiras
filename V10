/**
 * CORE DA API: Sincroniza dados com o SenseData de forma nativa e estruturada
 */
function processarAtualizacaoSenseData(clientesAfetados) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const ui = SpreadsheetApp.getUi();

  if (clientesAfetados.length <= 1) return ui.alert("Nenhum cliente afetado para sincronizar.");
  if (!descobrirCombinacaoAutenticacao()) return;

  ss.toast("Mapeando usuários na API...", "Aguarde", -1);
  SpreadsheetApp.flush();
  let mapaUsuarios = {};
  
  try {
    let resUsers = safeFetch(SENSE_BASE_URL + "/users?page_size=100", { method: "GET", headers: CONFIG_AUTENTICACAO_VALIDA, muteHttpExceptions: true });
    if (resUsers.getResponseCode() === 200) {
      let jsonUsers = JSON.parse(resUsers.getContentText());
      let listaUsers = jsonUsers.users || jsonUsers.data || jsonUsers.items || jsonUsers;
      if (Array.isArray(listaUsers)) listaUsers.forEach(u => { mapaUsuarios[u.name.toString().trim().toLowerCase()] = u; });
    }
  } catch(err) { return ui.alert("Erro ao ler usuários no SenseData: " + err.message); }

  let totalGeral = clientesAfetados.length - 1;
  let sincronizados = 0;
  let listaDeFalhas = []; 

  for (let i = 1; i < clientesAfetados.length; i++) {
    
    let pct = Math.round((i / totalGeral) * 100);
    ss.toast(`Sincronizando cliente ${i} de ${totalGeral}...`, `Progresso: ${pct}%`, -1);
    SpreadsheetApp.flush(); 

    let idLegacy = clientesAfetados[i][0].toString().trim();
    let nomeCliente = clientesAfetados[i][1];
    let nomeNovoCS = clientesAfetados[i][2].toString().trim();
    let cnpjCliente = clientesAfetados[i][6].toString().trim(); 
    let dadosCS = mapaUsuarios[nomeNovoCS.toLowerCase()];

    if (!dadosCS) {
      listaDeFalhas.push(`• Cliente [${nomeCliente}]: O CS '${nomeNovoCS}' não foi encontrado.`);
      continue; 
    }
    if (!cnpjCliente) {
      listaDeFalhas.push(`• Cliente [${nomeCliente}]: Erro! CNPJ em branco na planilha.`);
      continue;
    }

    let referenciaCSUnica = { "id": parseInt(dadosCS.id) };
    let idInternoSenseData = null;

    // 🎯 PASSO 1: RESOLUÇÃO DE ID VIA CNPJ
    try {
      let resBusca = safeFetch(`${SENSE_BASE_URL}/customers?cnpj=${encodeURIComponent(cnpjCliente)}`, { method: "GET", headers: CONFIG_AUTENTICACAO_VALIDA, muteHttpExceptions: true });
      if (resBusca.getResponseCode() === 200) {
        let jsonBusca = JSON.parse(resBusca.getContentText());
        let listaEncontrados = jsonBusca.customers || jsonBusca.data || jsonBusca.items || jsonBusca;
        if (Array.isArray(listaEncontrados) && listaEncontrados.length > 0) idInternoSenseData = listaEncontrados[0].id; 
      }
      if (!idInternoSenseData) {
        let cnpjLimpo = cnpjCliente.replace(/\D/g, "");
        if (cnpjLimpo !== cnpjCliente && cnpjLimpo !== "") {
          let resBuscaLimpo = safeFetch(`${SENSE_BASE_URL}/customers?cnpj=${encodeURIComponent(cnpjLimpo)}`, { method: "GET", headers: CONFIG_AUTENTICACAO_VALIDA, muteHttpExceptions: true });
          if (resBuscaLimpo.getResponseCode() === 200) {
            let jsonBuscaLimpo = JSON.parse(resBuscaLimpo.getContentText());
            let listaLimpo = jsonBuscaLimpo.customers || jsonBuscaLimpo.data || jsonBuscaLimpo.items || jsonBuscaLimpo;
            if (Array.isArray(listaLimpo) && listaLimpo.length > 0) idInternoSenseData = listaLimpo[0].id;
          }
        }
      }
    } catch(e) {}

    if (!idInternoSenseData) {
      listaDeFalhas.push(`• Cliente [${nomeCliente}]: Não localizado na base do SenseData.`);
      continue;
    }

    let sucessoCliente = true;

    // 🎯 PASSO 2: ATUALIZAÇÃO DO CLIENTE (Massa/Lote)
    try {
      let dataHojeISO = Utilities.formatDate(new Date(), "GMT-3", "yyyy-MM-dd");
      let payloadCliente = {
        "customers": [
          { "id": idInternoSenseData, "id_legacy": idLegacy, "name": nomeCliente, "name_contract": nomeCliente, "dt_register": dataHojeISO, "status": true, "cs": referenciaCSUnica }
        ]
      };
      let resA = safeFetch(`${SENSE_BASE_URL}/customers`, { method: "POST", headers: CONFIG_AUTENTICACAO_VALIDA, payload: JSON.stringify(payloadCliente), muteHttpExceptions: true });
      if (resA.getResponseCode() >= 300 || resA.getContentText().includes('"errors"')) {
        sucessoCliente = false;
        listaDeFalhas.push(`• Cliente [${nomeCliente}]: Erro no lote cadastral. Resposta: ${resA.getContentText()}`);
      }
    } catch(e) { sucessoCliente = false; }

    if (!sucessoCliente) continue;

    // 🎯 PASSO 3: REATRIBUIR TAREFAS PENDENTES EM LOTE
    try {
      let resTasks = safeFetch(`${SENSE_BASE_URL}/tasks?customer_id=${idInternoSenseData}`, { method: "GET", headers: CONFIG_AUTENTICACAO_VALIDA, muteHttpExceptions: true });
      if (resTasks.getResponseCode() === 200) {
        let jsonTasks = JSON.parse(resTasks.getContentText());
        let listaTasks = jsonTasks.tasks || jsonTasks.data || jsonTasks.items || jsonTasks;
        
        if (Array.isArray(listaTasks)) {
          let listaTasksAlterar = [];
          let dataHojeISO = Utilities.formatDate(new Date(), "GMT-3", "yyyy-MM-dd");
          
          listaTasks.forEach(task => {
            if (!task.customer || task.customer.id !== idInternoSenseData) return;

            let statusDesc = task.status && task.status.description ? task.status.description.toLowerCase() : "";
            if (!statusDesc.includes("concluid") && !statusDesc.includes("completed")) {
              
              let taskClean = {
                "id": task.id,
                "id_legacy": task.id_legacy || ("task_leg_" + task.id),
                "customer": { "id": idInternoSenseData },
                "description": task.description || "Tarefa Pendente",
                "start_date": task.start_date ? task.start_date.split("T")[0] : dataHojeISO,
                "due_date": task.due_date ? task.due_date.split("T")[0] : dataHojeISO,
                "type": { "id": task.type && task.type.id ? parseInt(task.type.id) : 11 },
                "status": { "id": task.status && task.status.id ? parseInt(task.status.id) : 1 },
                "priority": { "id": task.priority && task.priority.id ? parseInt(task.priority.id) : 2 },
                "owner": referenciaCSUnica, 
                "hours_spent": (isNaN(parseInt(task.hours_spent)) || parseInt(task.hours_spent) <= 0) ? 1 : parseInt(task.hours_spent)
              };
              
              listaTasksAlterar.push(taskClean);
            }
          });
          
          if (listaTasksAlterar.length > 0) {
            let resUpdateT = safeFetch(`${SENSE_BASE_URL}/tasks`, {
              method: "POST", 
              headers: CONFIG_AUTENTICACAO_VALIDA,
              payload: JSON.stringify({ "tasks": listaTasksAlterar }),
              muteHttpExceptions: true
            });
            if (resUpdateT.getResponseCode() >= 300 || resUpdateT.getContentText().includes('"errors"')) {
              listaDeFalhas.push(`• Cliente [${nomeCliente}]: Erro ao mover tarefas pendentes em lote. Resposta: ${resUpdateT.getContentText()}`);
            }
          }
        }
      }
    } catch(e) {}

    // 🎯 PASSO 4: CRIAR HISTÓRICO DE ALTERAÇÃO EM LOTE 
    // AGORA COM O ID EXATO CONTROLADO POR VOCÊ E A FRASE EXATA!
    try {
      let dataHojeISO = Utilities.formatDate(new Date(), "GMT-3", "yyyy-MM-dd");
      
      let payloadNovaTarefa = {
        "tasks": [
          {
            "id_legacy": "hist_" + idInternoSenseData + "_" + new Date().getTime(), 
            "customer": { "id": idInternoSenseData },
            
            // 🎯 USA O SEU CÓDIGO MANUAL DA LINHA 8
            "type": { "id": ID_TIPO_ALTERACAO_CS }, 
            
            "status": { "id": 2 }, 
            "priority": { "id": 2 }, 
            "description": "Alteração de CS - " + nomeNovoCS, // 🎯 A descrição/frase perfeita exigida
            "notes": `Transferência operacional realizada para - ${nomeNovoCS}`,
            "start_date": dataHojeISO,
            "due_date": dataHojeISO,
            "end_date": dataHojeISO + "T00:00:00",
            "owner": referenciaCSUnica, 
            "hours_spent": 1 
          }
        ]
      };
      
      let resC = safeFetch(`${SENSE_BASE_URL}/tasks`, {
        method: "POST", 
        headers: CONFIG_AUTENTICACAO_VALIDA,
        payload: JSON.stringify(payloadNovaTarefa),
        muteHttpExceptions: true
      });
      
      let txtC = resC.getContentText();
      if (resC.getResponseCode() >= 300 || txtC.includes('"errors"')) {
        listaDeFalhas.push(`• Cliente [${nomeCliente}]: Erro ao gerar histórico em lote. Resposta: ${txtC}`);
      }
    } catch(e) {}

    sincronizados++;
  }

  ss.toast("Sincronização concluída com sucesso!", "Progresso: 100%", 5);
  SpreadsheetApp.flush();
  Utilities.sleep(500);

  if (listaDeFalhas.length > 0) {
    ui.alert(
      "⚠️ Sincronização Concluída com Alertas",
      `Clientes processados com sucesso: ${sincronizados} de ${totalGeral}.\n\n` +
      `Detalhes das pendências detectadas nas atividades:\n\n` +
      listaDeFalhas.join("\n\n"),
      ui.ButtonSet.OK
    );
  } else {
    ui.alert("🚀 Sincronização Concluída!", `Sucesso total! Foram atualizados ${sincronizados} clientes, reatribuídas suas tarefas pendentes e gerados os logs de histórico com sucesso!`, ui.ButtonSet.OK);
  }
}

/**
 * 🕵️ A FUNÇÃO ESPIÃ 
 */
function espiarTiposDeAtividade() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  
  if (!descobrirCombinacaoAutenticacao()) {
    SpreadsheetApp.getUi().alert("Erro", "Falha de autenticação ao conectar na API.", SpreadsheetApp.getUi().ButtonSet.OK);
    return;
  }
  
  ss.toast("Vasculhando o painel do SenseData...", "Espião Ativado", -1);
  SpreadsheetApp.flush();
  
  try {
    // 🎯 Força buscar até 300 tipos de atividades de uma vez só (livre de paginação curta)
    let res = UrlFetchApp.fetch(SENSE_BASE_URL + "/task_types?page_size=300", {
      method: "GET",
      headers: CONFIG_AUTENTICACAO_VALIDA,
      muteHttpExceptions: true
    });
    
    if (res.getResponseCode() === 200) {
      let json = JSON.parse(res.getContentText());
      let lista = json.task_types || json.data || json.items || json;
      
      if (Array.isArray(lista) && lista.length > 0) {
        let abaTipos = ss.getSheetByName("Tipos de Atividade") || ss.insertSheet("Tipos de Atividade");
        abaTipos.clear().clearFormats();
        
        let dadosAba = [["ID DO TIPO", "NOME NA TELA (CAPTION)", "CÓDIGO INTERNO (DESCRIPTION)"]];
        lista.forEach(t => {
          dadosAba.push([t.id, t.caption || t.name, t.description]);
        });
        
        abaTipos.getRange(1, 1, dadosAba.length, 3).setValues(dadosAba);
        abaTipos.getRange(1, 1, 1, 3).setFontWeight("bold").setBackground("#444444").setFontColor("white");
        abaTipos.setColumnWidth(1, 120);
        abaTipos.setColumnWidth(2, 250);
        abaTipos.setColumnWidth(3, 200);
        abaTipos.activate();
        
        ss.toast("Tabela de tipos gerada com sucesso! Volte ao editor e preencha a Linha 8.", "Concluído", 10);
      } else {
        ss.toast("A API retornou uma lista vazia.", "Aviso", 5);
      }
    } else {
      ss.toast(`Erro HTTP: ${res.getResponseCode()}`, "Falha de API", 5);
    }
  } catch (e) {
    ss.toast(`Erro técnico: ${e.message}`, "Falha de Script", 5);
  }
}

