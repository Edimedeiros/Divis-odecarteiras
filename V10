/**
 * FUNÇÃO DE ENVIO SEGURO (ANTI-BLOQUEIO 429)
 */
function safeFetch(url, options) {
  let tentativas = 0;
  let res = null;
  
  while (tentativas < 5) {
    res = UrlFetchApp.fetch(url, options);
    let status = res.getResponseCode();
    
    if (status === 429) {
      let tempoEspera = 15; 
      try {
        let json = JSON.parse(res.getContentText());
        if (json.errors && json.errors[0] && json.errors[0].reset) {
          tempoEspera = parseInt(json.errors[0].reset) + 2; 
        }
      } catch(e) {}
      
      SpreadsheetApp.getActiveSpreadsheet().toast(`API cheia. Pausando por ${tempoEspera} segundos para respeitar o limite...`, "SenseData", -1);
      SpreadsheetApp.flush(); 
      Utilities.sleep(tempoEspera * 1000);
      tentativas++;
    } else {
      return res;
    }
  }
  return res;
}

/**
 * SCANNER AUTOMÁTICO: Descobre o formato exato exigido pelo SenseData (Elimina Erro 401)
 */
function descobrirCombinacaoAutenticacao() {
  if (CONFIG_AUTENTICACAO_VALIDA) return true;

  const combinacoes = [
    { label: "Bearer + Token Decodificado", headers: { "Authorization": "Bearer " + TOKEN_DECODIFICADO, "Content-Type": "application/json" } },
    { label: "Bearer + Token Original", headers: { "Authorization": "Bearer " + TOKEN_ORIGINAL, "Content-Type": "application/json" } },
    { label: "X-SenseData-Token + Token Decodificado", headers: { "X-SenseData-Token": TOKEN_DECODIFICADO, "Content-Type": "application/json" } },
    { label: "X-SenseData-Token + Token Original", headers: { "X-SenseData-Token": TOKEN_ORIGINAL, "Content-Type": "application/json" } },
    { label: "Authorization Direto + Token Decodificado", headers: { "Authorization": TOKEN_DECODIFICADO, "Content-Type": "application/json" } },
    { label: "Authorization Direto + Token Original", headers: { "Authorization": TOKEN_ORIGINAL, "Content-Type": "application/json" } }
  ];

  for (let i = 0; i < combinacoes.length; i++) {
    try {
      let res = UrlFetchApp.fetch(SENSE_BASE_URL + "/users?page_size=1", {
        method: "GET",
        headers: combinacoes[i].headers,
        muteHttpExceptions: true
      });
      
      if (res.getResponseCode() === 200) {
        CONFIG_AUTENTICACAO_VALIDA = combinacoes[i].headers;
        console.log(`🎯 Conexão estabelecida usando o método: ${combinacoes[i].label}`);
        return true;
      }
    } catch(e) {}
  }
  return false;
}

/**
 * FUNÇÃO PRINCIPAL: Menu expandido com 3 opções.
 */
function executarAutomacaoCompleta() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const ui = SpreadsheetApp.getUi();
  
  const menuMsg = "Escolha a operação desejada:\n\n" +
                  "1) ➕ Criar novas carteiras (Digitar nomes)\n" +
                  "2) 🗑️ Dissolver carteiras (Escolher recebedores via API)\n" +
                  "3) 🔄 MISTO (Dissolver + Digitar novos)\n\n" +
                  "Digite o número da opção (1, 2 ou 3):";
                  
  const promptInicial = ui.prompt("🚀 Gestão de Carteiras", menuMsg, ui.ButtonSet.OK_CANCEL);
  
  if (promptInicial.getSelectedButton() !== ui.Button.OK) return;
  const opcao = promptInicial.getResponseText().trim();

  let modo = "";
  let parametro = null;

  if (opcao === "1") {
    modo = "CRIAR";
    const prompt = ui.prompt("Montagem de Carteira", "Digite o(s) NOME(S) do(s) novo(s) analista(s).\n\nPara mais de um, separe por ponto e vírgula (;):", ui.ButtonSet.OK_CANCEL);
    if (prompt.getSelectedButton() !== ui.Button.OK) return;
    
    let nomesNovos = prompt.getResponseText().split(";").map(n => n.trim()).filter(n => n !== "");
    if (nomesNovos.length === 0) return ui.alert("Nenhum nome válido inserido.");
    parametro = { novos: nomesNovos };

  } else if (opcao === "2") {
    modo = "DISSOLVER";
    let listaSair = solicitarDissolucao(ui, ss);
    if (!listaSair) return;
    
    let listaReceber = solicitarRecebedoresAPI(ui, ss);
    if (!listaReceber) return;

    parametro = { sair: listaSair, receber: listaReceber };

  } else if (opcao === "3") {
    modo = "MISTO";
    let listaSair = solicitarDissolucao(ui, ss);
    if (!listaSair) return;

    let listaReceber = solicitarRecebedoresAPI(ui, ss);
    if (!listaReceber) return;

    const promptNovos = ui.prompt("Misto: Novos Analistas", "Digite o(s) NOME(S) dos NOVOS analistas (separe por ;).\nOu deixe em branco se não houver novos.", ui.ButtonSet.OK_CANCEL);
    if (promptNovos.getSelectedButton() !== ui.Button.OK) return;
    
    let nomesNovos = promptNovos.getResponseText().split(";").map(n => n.trim()).filter(n => n !== "");
    parametro = { sair: listaSair, receber: listaReceber, novos: nomesNovos };

  } else {
    return ui.alert("Opção inválida.");
  }

  unificarDados(modo);
  distribuirCarteiras(modo, parametro);
}

/**
 * FUNÇÃO AUXILIAR: Pede a lista de quem vai sair (Da Planilha)
 */
function solicitarDissolucao(ui, ss) {
  const abaClientes = ss.getSheetByName("Tabela clientes");
  const dados = abaClientes.getDataRange().getValues();
  const cabecalho = dados[0];
  const norm = (t) => t ? t.toString().trim().toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "") : "";
  const idxCS = cabecalho.findIndex(c => norm(c) === "cs");
  
  let analistas = [...new Set(dados.slice(1).map(r => r[idxCS]).filter(c => c !== ""))].sort();
  let listaTxt = analistas.map((a, i) => (i + 1) + ") " + a).join("\n");
  
  const prompt = ui.prompt("🗑️ Passo 1: Quem SAI?", "Digite os NÚMEROS dos CSs que SAÍRAM (separe por vírgula):\n\n" + listaTxt, ui.ButtonSet.OK_CANCEL);
  
  if (prompt.getSelectedButton() !== ui.Button.OK) return null;
  
  let escolhas = prompt.getResponseText().split(",").map(n => parseInt(n.trim()) - 1);
  let nomes = escolhas.map(i => analistas[i]).filter(n => n !== undefined);
  
  if (nomes.length === 0) {
    ui.alert("Seleção inválida.");
    return null;
  }
  return nomes;
}

/**
 * FUNÇÃO AUXILIAR: Busca analistas ATIVOS na API
 */
function solicitarRecebedoresAPI(ui, ss) {
  ss.toast("Validando acesso com o SenseData...", "API Auth", -1);
  SpreadsheetApp.flush();
  
  if (!descobrirCombinacaoAutenticacao()) {
    ui.alert("❌ Erro de Autenticação Crítico", "O SenseData recusou as chaves de acesso fornecidas.", ui.ButtonSet.OK);
    return null;
  }

  ss.toast("Buscando analistas ativos no SenseData...", "API", -1);
  SpreadsheetApp.flush();
  let analistasAPI = [];

  try {
    let res = safeFetch(SENSE_BASE_URL + "/users?page_size=100", {
      method: "GET",
      headers: CONFIG_AUTENTICACAO_VALIDA,
      muteHttpExceptions: true
    });

    if (res.getResponseCode() === 200) {
      let json = JSON.parse(res.getContentText());
      let users = json.users || json.data || json.items || json;
      if (Array.isArray(users)) {
        analistasAPI = users.filter(u => u.active).map(u => u.name).sort();
      }
    } else {
      ui.alert("Erro de API", "Código: " + res.getResponseCode() + "\nResposta:\n" + res.getContentText(), ui.ButtonSet.OK);
      return null;
    }
  } catch(e) {
    ui.alert("Erro de Conexão", e.message, ui.ButtonSet.OK);
    return null;
  }

  let listaTxt = analistasAPI.map((a, i) => (i + 1) + ") " + a).join("\n");
  const prompt = ui.prompt("📥 Passo 2: Quem RECEBE?", 
    "Analistas ATIVOS no SenseData (HOM).\nDigite os NÚMEROS de quem VAI RECEBER os clientes (separe por vírgula):\n\n" + listaTxt, 
    ui.ButtonSet.OK_CANCEL);
  
  if (prompt.getSelectedButton() !== ui.Button.OK) return null;
  
  let escolhas = prompt.getResponseText().split(",").map(n => parseInt(n.trim()) - 1);
  let nomes = escolhas.map(i => analistasAPI[i]).filter(n => n !== undefined);
  if (nomes.length === 0) return ui.alert("Seleção inválida."), null;
  
  return nomes;
}

/**
 * ETAPA 1: UNIFICAÇÃO
 */
function unificarDados(modo) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const abaClientes = ss.getSheetByName("Tabela clientes");
  const abaJornada = ss.getSheetByName("Tabela jornada");
  const abaUnificados = ss.getSheetByName("Dados Unificados");
  
  ss.toast("Cruzando dados e mapeando CNPJ...", "Etapa 1", -1);
  SpreadsheetApp.flush();

  const dadosClientes = abaClientes.getDataRange().getValues();
  const dadosJornada = abaJornada.getDataRange().getValues();
  const cabecalhoCli = dadosClientes[0];

  const norm = (t) => t ? t.toString().trim().toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "") : "";
  const localizar = (nome) => cabecalhoCli.findIndex(c => norm(c) === norm(nome));

  const idxId = localizar("ID ORIGINAL"), idxCS = localizar("CS"), idxLider = localizar("Lider Ongoing"),
        idxFase = localizar("Fase"), idxMRR = localizar("MRR"), idxNome = localizar("Cliente"),
        idxCNPJ = localizar("CNPJ"); 

  const jornadaVazia = (dadosJornada.length <= 1 || (dadosJornada.length === 2 && !dadosJornada[1][0]));

  let listaUnified = [];

  if (jornadaVazia) { 
    for (let i = 1; i < dadosClientes.length; i++) {
      let id = dadosClientes[i][idxId].toString().trim();
      if (!id) continue;
      let c = dadosClientes[i];
      let faseFinal = c[idxFase].toString().replace(/Fly$/i, "Flying");
      let cnpj = idxCNPJ !== -1 ? c[idxCNPJ].toString().trim() : "";
      listaUnified.push([id, c[idxNome], c[idxCS], faseFinal, c[idxMRR], c[idxLider], cnpj]);
    }
  } else {
    let mapaClientes = {};
    for (let i = 1; i < dadosClientes.length; i++) {
      let id = dadosClientes[i][idxId].toString().trim();
      let cnpj = idxCNPJ !== -1 ? dadosClientes[i][idxCNPJ].toString().trim() : "";
      if (id) mapaClientes[id] = { nome: dadosClientes[i][idxNome], cs: dadosClientes[i][idxCS], fase: dadosClientes[i][idxFase], mrr: dadosClientes[i][idxMRR], lider: dadosClientes[i][idxLider], cnpj: cnpj };
    }

    const fasesIncluir = ["mayday", "alert", "en route", "fly", "flying", "onboarding", "retomada"];
    const excluir = ["cancelado", "tratativa de cancelamento"];

    for (let j = 1; j < dadosJornada.length; j++) {
      let celula = dadosJornada[j][0].toString();
      if (!celula) continue;
      let texto = celula.toLowerCase();

      if (excluir.some(termo => texto.includes(termo))) continue;
      if (!fasesIncluir.some(termo => texto.includes(termo))) continue;

      let match = celula.match(/"(\d+)"\s*$/);
      if (match && mapaClientes[match[1]]) {
        let c = mapaClientes[match[1]];
        let faseFinal = c.fase.toString().replace(/Fly$/i, "Flying");
        listaUnified.push([match[1], c.nome, c.cs, faseFinal, c.mrr, c.lider, c.cnpj]);
      }
    }
  }

  abaUnificados.clear().getRange(1, 1, 1, 7).setValues([["ID Original", "Cliente", "CS", "Fase", "MRR", "Lider Ongoing", "CNPJ"]]).setFontWeight("bold").setBackground("#E0E0E0");
  if (listaUnified.length > 0) abaUnificados.getRange(2, 1, listaUnified.length, 7).setValues(listaUnified);
}

/**
 * ETAPA 2: DISTRIBUIÇÃO E PROCESSAMENTO
 */
function distribuirCarteiras(modo, parametro) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const ui = SpreadsheetApp.getUi();
  const abaUnificados = ss.getSheetByName("Dados Unificados");
  const abaCarteiraFinal = ss.getSheetByName("Carteira Final");
  
  ss.toast("Equilibrando MRR e gerando painéis...", "Etapa 2", -1);
  SpreadsheetApp.flush();

  const clientes = abaUnificados.getDataRange().getValues().slice(1);
  let analistasAtuais = [...new Set(clientes.map(c => c[2]).filter(cs => cs !== ""))];
  
  let analistasAlvo = [];
  let clientesParaDistribuir = [];
  let clientesFixos = [];

  if (modo === "CRIAR") {
    analistasAlvo = [...analistasAtuais, ...parametro.novos];
    clientesParaDistribuir = clientes;
  } 
  else if (modo === "DISSOLVER") {
    analistasAlvo = parametro.receber;
    clientes.forEach(c => parametro.sair.includes(c[2]) ? clientesParaDistribuir.push(c) : clientesFixos.push(c));
  } 
  else if (modo === "MISTO") {
    analistasAlvo = [...parametro.receber, ...parametro.novos];
    clientes.forEach(c => parametro.sair.includes(c[2]) ? clientesParaDistribuir.push(c) : clientesFixos.push(c));
  }

  if (analistasAlvo.length === 0) {
    return ui.alert("Erro", "Nenhum analista de destino selecionado para receber os clientes.", ui.ButtonSet.OK);
  }

  let stats = {};
  let todosAnalistas = new Set([...analistasAtuais, ...analistasAlvo]);
  todosAnalistas.forEach(n => stats[n] = { mayday: 0, alert: 0, enroute: 0, flying: 0, total: 0, mrr: 0 });

  clientesFixos.forEach(c => {
    let analista = c[2];
    let f = c[3].toString().toLowerCase();
    if (f.includes("mayday")) stats[analista].mayday++;
    else if (f.includes("alert")) stats[analista].alert++;
    else if (f.includes("en route")) stats[analista].enroute++;
    else if (f.includes("flying")) stats[analista].flying++;
    stats[analista].total++;
    stats[analista].mrr += (parseFloat(c[4]) || 0);
  });

  clientesParaDistribuir.sort((a, b) => (parseFloat(b[4]) || 0) - (parseFloat(a[4]) || 0));
  let resultadoExibicao = [["ID ORIGINAL", "CLIENTE", "NOVO ANALISTA", "LÍDER ONGOING", "FASE", "MRR", "CNPJ"]];

  clientesParaDistribuir.forEach((cliente, i) => {
    let turno = Math.floor(i / analistasAlvo.length);
    let dir = i % analistasAlvo.length;
    let idxA = (turno % 2 === 0) ? dir : (analistasAlvo.length - 1 - dir);
    let analistaDestino = analistasAlvo[idxA];
    let analistaOriginal = cliente[2];

    if (analistaDestino !== analistaOriginal) {
      resultadoExibicao.push([cliente[0], cliente[1], analistaDestino, cliente[5], cliente[3], cliente[4], cliente[6]]);
    }

    let f = cliente[3].toString().toLowerCase();
    if (f.includes("mayday")) stats[analistaDestino].mayday++;
    else if (f.includes("alert")) stats[analistaDestino].alert++;
    else if (f.includes("en route")) stats[analistaDestino].enroute++;
    else if (f.includes("flying")) stats[analistaDestino].flying++;
    stats[analistaDestino].total++;
    stats[analistaDestino].mrr += (parseFloat(cliente[4]) || 0);
  });

  abaCarteiraFinal.clear().clearFormats();
  if (resultadoExibicao.length > 1) {
    abaCarteiraFinal.getRange(1, 1, resultadoExibicao.length, 7).setValues(resultadoExibicao); 
    abaCarteiraFinal.getRange(1, 1, 1, 7).setFontWeight("bold").setBackground("#444444").setFontColor("white");
    abaCarteiraFinal.getRange(2, 6, resultadoExibicao.length - 1, 1).setNumberFormat("R$ #,##0.00");
  }

  let resumoData = [["Lista de Analistas", "Mayday", "Alert", "En Route", "Flying", "Total Clientes", "Total MRR"]];
  Object.keys(stats).sort().forEach(n => {
    if (stats[n].total > 0 || analistasAlvo.includes(n)) {
      resumoData.push([n, stats[n].mayday, stats[n].alert, stats[n].enroute, stats[n].flying, stats[n].total, stats[n].mrr]);
    }
  });

  abaCarteiraFinal.getRange(1, 10, resumoData.length, 7).setValues(resumoData);
  abaCarteiraFinal.getRange(1, 10, 1, 7).setFontWeight("bold").setBackground("#F3F3F3");
  abaCarteiraFinal.getRange(2, 16, resumoData.length - 1, 1).setNumberFormat("R$ #,##0.00");
  abaCarteiraFinal.getRange(1, 10, resumoData.length, 7).setBorder(true, true, true, true, true, true);
  
  abaCarteiraFinal.setColumnWidth(2, 250); 
  abaCarteiraFinal.setColumnWidth(3, 150); 
  abaCarteiraFinal.setColumnWidth(4, 150); 
  abaCarteiraFinal.setColumnWidth(10, 180); 
  abaCarteiraFinal.setColumnWidth(16, 120); 

  criarBackupNoDrive(modo);

  const atualizarSense = ui.alert("Integração SenseData", "Deseja atualizar o SenseData com as novas atribuições?", ui.ButtonSet.YES_NO);
  if (atualizarSense === ui.Button.YES) {
    processarAtualizacaoSenseData(resultadoExibicao);
  } else {
    ss.toast("Processo concluído!", "Finalizado");
  }
}

/**
