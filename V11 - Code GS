function obterListaDeAnalistas(setor, time) {
  try {
    if (!descobrirCombinacaoAutenticacao()) return { erro: "Falha de Autenticação com o SenseData." };
    
    let profileAlvo = "";
    if (setor === "3") profileAlvo = "Analista Ongoing - Adoção";
    else {
      if (setor === "2" && time === "1") profileAlvo = "Analista Ongoing";
      else if (setor === "2" && time === "2") profileAlvo = "Analista Ongoing - GC";
      else if (setor === "1" && time === "1") profileAlvo = "Analista Onboarding";
      else if (setor === "1" && time === "2") profileAlvo = "Analista Onboarding - GC";
    }
    
    if (!profileAlvo) return { erro: "Perfil alvo não identificado." };

    let todosUsuarios = buscarDadosPaginadosAPI("/users");
    let usuariosTime = todosUsuarios.filter(u => u.active && u.profile && u.profile.name === profileAlvo);
    return { nomes: usuariosTime.map(u => u.name).sort() };
  } catch (e) {
    return { erro: "Erro de comunicação com a API: " + e.message };
  }
}

function receberComandosDoPainel(payload) {
  CacheService.getUserCache().remove('progresso_automacao');

  if (!descobrirCombinacaoAutenticacao()) {
    throw new Error("O SenseData recusou as chaves de acesso. Verifique as credenciais.");
  }

  let profileAlvo = "";
  let nomeSetorTxt = "";

  if (payload.setor === "1") { nomeSetorTxt = "Onboarding"; }
  else if (payload.setor === "2") { nomeSetorTxt = "Ongoing"; }
  else if (payload.setor === "3") { profileAlvo = "Analista Ongoing - Adoção"; nomeSetorTxt = "Adoção"; } 

  if (payload.setor !== "3") {
    if (payload.setor === "2" && payload.time === "1") profileAlvo = "Analista Ongoing";
    else if (payload.setor === "2" && payload.time === "2") profileAlvo = "Analista Ongoing - GC";
    else if (payload.setor === "1" && payload.time === "1") profileAlvo = "Analista Onboarding";
    else if (payload.setor === "1" && payload.time === "2") profileAlvo = "Analista Onboarding - GC";
  }

  if (payload.operacao === "1") {
    rotinaMontarNovasCarteirasWEB_Ponte(profileAlvo, nomeSetorTxt, payload.nomes_montar, payload.backup_drive);
  } else if (payload.operacao === "2") {
    rotinaDesfazerCarteirasWEB_Ponte(profileAlvo, nomeSetorTxt, payload.nome_saindo, payload.nomes_recebedores, payload.backup_drive);
  } else if (payload.operacao === "3") {
    rotinaTrocasPontuaisWEB_Ponte(profileAlvo, nomeSetorTxt, payload.ids_pontual, payload.destino_pontual, payload.backup_drive);
  }

  SpreadsheetApp.flush();
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let abaA = ss.getSheetByName("Clientes Afetados");
  let abaC = ss.getSheetByName("Carteira Final");

  let dadosAfetados = abaA ? abaA.getDataRange().getDisplayValues() : [["Sem dados"]];
  let dadosCarteira = abaC ? abaC.getDataRange().getDisplayValues() : [["Sem dados"]];

  return {
    afetados: dadosAfetados,
    carteira: dadosCarteira
  };
}

/**
 * 🌉 PONTES ADAPTADORAS DE INPUT
 */
function rotinaMontarNovasCarteirasWEB_Ponte(profileAlvo, nomeSetorTxt, nomesMontarRaw, salvarBackup) {
  let todosUsuarios = buscarDadosPaginadosAPI("/users");
  let listaNomesNoBanco = todosUsuarios.map(u => u.name.toLowerCase());
  const novosAnalistas = nomesMontarRaw.split(";").map(n => n.trim()).filter(n => n !== "");
  let errosGrafia = novosAnalistas.filter(nome => !listaNomesNoBanco.includes(nome.toLowerCase()));
  if (errosGrafia.length > 0) throw new Error("Analistas não existem: " + errosGrafia.join(", "));
  
  let usuariosTime = todosUsuarios.filter(u => u.active && u.profile && u.profile.name === profileAlvo);
  let nomesNovosLower = novosAnalistas.map(n => n.toLowerCase());
  usuariosTime = usuariosTime.filter(u => !nomesNovosLower.includes(u.name.toLowerCase()));
  let nomesTimeAntigo = usuariosTime.map(u => u.name.toLowerCase());
  let todosClientes = buscarDadosPaginadosAPI("/customers"); 
  let clientesAtivosTime = todosClientes.filter(c => {
    let statusDesc = c.status && c.status.description ? c.status.description.toLowerCase() : "";
    let donoNome = c.cs && c.cs.name ? c.cs.name.toLowerCase() : "";
    return !statusDesc.includes("inativ") && nomesTimeAntigo.includes(donoNome);
  });
  if (clientesAtivosTime.length === 0) throw new Error("Nenhum cliente ativo para este time.");
  
  let sessentaDiasAtras = new Date(new Date().getTime() - (60 * 24 * 60 * 60 * 1000));
  let idsBloqueados60Dias = new Set();
  try {
    let paginaT = 1; let continuarLendoTasks = true;
    while (continuarLendoTasks) {
      let resT = safeFetch(SENSE_BASE_URL + "/tasks?type_id=" + ID_TIPO_ALTERACAO_CS + "&page_size=100&page=" + paginaT, { method: "GET", headers: CONFIG_AUTENTICACAO_VALIDA, muteHttpExceptions: true });
      if (resT && resT.getResponseCode() === 200) {
        let jsonT = JSON.parse(resT.getContentText()); let listaT = jsonT.tasks || jsonT.data || [];
        if (listaT.length === 0) { continuarLendoTasks = false; } else {
          let algumaTaskNaJanela = false;
          listaT.forEach(t => {
            if (t.end_date) {
              let dataTask = new Date(t.end_date.split("T")[0]);
              if (dataTask >= sessentaDiasAtras) { algumaTaskNaJanela = true; if (t.customer && t.customer.id) idsBloqueados60Dias.add(t.customer.id); }
            }
          });
          if (!algumaTaskNaJanela) continuarLendoTasks = false;
          paginaT++; if (jsonT.next_page === null || !jsonT.next_page) continuarLendoTasks = false;
        }
      } else { continuarLendoTasks = false; }
    }
  } catch(e) {}

  let clientesDisponiveis = clientesAtivosTime.filter(c => !idsBloqueados60Dias.has(c.id));
  if (clientesDisponiveis.length === 0) throw new Error("Todos os clientes foram movidos nos últimos 60 dias.");
  let contagem = {}; usuariosTime.forEach(u => contagem[u.name.toLowerCase()] = 0);
  clientesDisponiveis.forEach(c => { let d = c.cs.name.toLowerCase(); if (contagem[d] !== undefined) contagem[d]++; });
  let media = Math.floor(clientesDisponiveis.length / (usuariosTime.length + novosAnalistas.length));
  if (media <= 0) throw new Error("Clientes insuficientes para dividir.");
  
  let saude = { "mayday": [], "alert": [], "en route": [], "flying": [] };
  clientesDisponiveis.forEach(c => {
    let f = (c.stage || "").toLowerCase();
    if (f.includes("mayday")) saude["mayday"].push(c); else if (f.includes("alert")) saude["alert"].push(c);
    else if (f.includes("route")) saude["en route"].push(c); else saude["flying"].push(c);
  });
  let prop = { "mayday": saude.mayday.length / clientesDisponiveis.length, "alert": saude.alert.length / clientesDisponiveis.length, "en route": saude["en route"].length / clientesDisponiveis.length, "flying": saude.flying.length / clientesDisponiveis.length };
  
  let novas = {};
  novosAnalistas.forEach(nome => {
    novas[nome] = [];
    ["mayday", "alert", "en route", "flying"].forEach(s => {
      let cota = Math.round(media * prop[s]);
      for (let k = 0; k < cota; k++) {
        if (saude[s].length > 0) {
          saude[s].sort((a, b) => contagem[b.cs.name.toLowerCase()] - contagem[a.cs.name.toLowerCase()]);
          let escolhido = saude[s].shift(); novas[nome].push(escolhido); contagem[escolhido.cs.name.toLowerCase()]--;
        }
      }
    });
  });
  processarEfetivacaoLote(novas, "CRIAR", profileAlvo, todosClientes, todosUsuarios, nomeSetorTxt, null, salvarBackup);
}

function rotinaDesfazerCarteirasWEB_Ponte(profileAlvo, nomeSetorTxt, nomeSaindoRaw, receptoresRaw, salvarBackup) {
  let todosUsuarios = buscarDadosPaginadosAPI("/users");
  let usuariosTime = todosUsuarios.filter(u => u.active && u.profile && u.profile.name === profileAlvo);
  let analistaSaindo = usuariosTime.find(u => u.name.toLowerCase() === nomeSaindoRaw.toLowerCase().trim());
  if (!analistaSaindo) throw new Error("Analista saindo não encontrado no time.");
  
  let analistasRestantes = usuariosTime.filter(u => u.id !== analistaSaindo.id);
  let receptores = analistasRestantes;
  if (receptoresRaw) {
    let nomesFiltro = receptoresRaw.split(";").map(n => n.trim().toLowerCase());
    receptores = analistasRestantes.filter(u => nomesFiltro.includes(u.name.toLowerCase()));
  }
  if (receptores.length === 0) throw new Error("Nenhum receptor ativo configurado.");
  
  let todosClientes = buscarDadosPaginadosAPI("/customers"); 
  let carteiraOrfa = todosClientes.filter(c => {
    let statusDesc = c.status && c.status.description ? c.status.description.toLowerCase() : "";
    return !statusDesc.includes("inativ") && c.cs && c.cs.id === analistaSaindo.id;
  });
  if (carteiraOrfa.length === 0) throw new Error("A carteira selecionada já está vazia ou inativa.");
  
  let contagem = {}; receptores.forEach(r => contagem[r.name.toLowerCase()] = 0);
  todosClientes.forEach(c => {
    let statusDesc = c.status && c.status.description ? c.status.description.toLowerCase() : "";
    if (c.cs && !statusDesc.includes("inativ") && contagem[c.cs.name.toLowerCase()] !== undefined) contagem[c.cs.name.toLowerCase()]++;
  });
  
  let novas = {}; receptores.forEach(r => novas[r.name] = []);
  carteiraOrfa.sort((a, b) => (parseFloat(b.size) || 0) - (parseFloat(a.size) || 0));
  carteiraOrfa.forEach(cliente => {
    receptores.sort((a, b) => contagem[a.name.toLowerCase()] - contagem[b.name.toLowerCase()]);
    let escolhido = receptores[0]; novas[escolhido.name].push(cliente); contagem[escolhido.name.toLowerCase()]++; 
  });
  processarEfetivacaoLote(novas, "DISSOLVER", profileAlvo, todosClientes, todosUsuarios, nomeSetorTxt, analistaSaindo.name, salvarBackup);
}

function rotinaTrocasPontuaisWEB_Ponte(profileAlvo, nomeSetorTxt, idsRaw, destinoRaw, salvarBackup) {
  const listaIds = idsRaw.split(";").map(id => id.trim()).filter(id => id !== "");
  if (listaIds.length === 0) throw new Error("Nenhum ID inserido.");
  let clientesParaMover = [];
  listaIds.forEach(id => {
    let res = safeFetch(SENSE_BASE_URL + "/customers?id_legacy=" + encodeURIComponent(id), { method: "GET", headers: CONFIG_AUTENTICACAO_VALIDA, muteHttpExceptions: true });
    if (res && res.getResponseCode() === 200) {
      let json = JSON.parse(res.getContentText()); let lote = json.customers || json.data || [];
      if (lote.length > 0) clientesParaMover.push(lote[0]);
      else {
        let res2 = safeFetch(SENSE_BASE_URL + "/customers/" + id, { method: "GET", headers: CONFIG_AUTENTICACAO_VALIDA, muteHttpExceptions: true });
        if (res2 && res2.getResponseCode() === 200) clientesParaMover.push(JSON.parse(res2.getContentText()));
      }
    }
  });
  if (clientesParaMover.length === 0) throw new Error("Nenhum dos IDs localizados.");
  
  let todosUsuarios = buscarDadosPaginadosAPI("/users");
  let usuariosTime = todosUsuarios.filter(u => u.active && u.profile && u.profile.name === profileAlvo);
  let analistaDestino = usuariosTime.find(u => u.name.toLowerCase() === destinoRaw.trim().toLowerCase());
  if (!analistaDestino) throw new Error("Analista receptor não localizado no time.");
  
  let novasCarteirasDistribuidas = {};
  novasCarteirasDistribuidas[analistaDestino.name] = clientesParaMover;
  processarEfetivacaoLote(novasCarteirasDistribuidas, "PONTUAL", profileAlvo, null, todosUsuarios, nomeSetorTxt, null, salvarBackup);
}
